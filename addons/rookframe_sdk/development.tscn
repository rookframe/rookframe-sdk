[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/rookframe_sdk/development.gd" id="1"]

[node name="Rookframe" type="EditorDock"]
title = "Rookframe"
default_slot = 4
layout_key = "rookframe_development"

[node name="Scroll" type="ScrollContainer" parent="."]
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Scroll"]
custom_minimum_size = Vector2(270, 0)
size_flags_horizontal = 3
script = ExtResource("1")

[node name="Title" type="Label" parent="Scroll/Content"]
text = "Package development"

[node name="Explanation" type="Label" parent="Scroll/Content"]
text = "One editable Package. A local World.\nNo network Participants."
autowrap_mode = 2

[node name="RuntimeLabel" type="Label" parent="Scroll/Content"]
text = "Development runtime"

[node name="RuntimeRow" type="HBoxContainer" parent="Scroll/Content"]

[node name="Runtime" type="LineEdit" parent="Scroll/Content/RuntimeRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "Runtime bundle manifest"

[node name="Browse" type="Button" parent="Scroll/Content/RuntimeRow"]
unique_name_in_owner = true
text = "Browse…"

[node name="WorldLabel" type="Label" parent="Scroll/Content"]
text = "Development World name"

[node name="WorldName" type="LineEdit" parent="Scroll/Content"]
unique_name_in_owner = true
text = "Package development"

[node name="SystemLabel" type="Label" parent="Scroll/Content"]
text = "System Manifest URL (optional Packages only)"
autowrap_mode = 2

[node name="SystemManifest" type="LineEdit" parent="Scroll/Content"]
unique_name_in_owner = true
placeholder_text = "https://…"

[node name="PackagesLabel" type="Label" parent="Scroll/Content"]
text = "Other Package Manifest URLs (one per line)"
autowrap_mode = 2

[node name="Packages" type="TextEdit" parent="Scroll/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
placeholder_text = "https://…"

[node name="Prepare" type="Button" parent="Scroll/Content"]
unique_name_in_owner = true
text = "Save and prepare"

[node name="Actions" type="HBoxContainer" parent="Scroll/Content"]

[node name="Run" type="Button" parent="Scroll/Content/Actions"]
unique_name_in_owner = true
size_flags_horizontal = 3
text = "Run development World"

[node name="Stop" type="Button" parent="Scroll/Content/Actions"]
unique_name_in_owner = true
text = "Stop"

[node name="Status" type="Label" parent="Scroll/Content"]
unique_name_in_owner = true
text = "Choose the development runtime shipped with your Rookframe installation."
autowrap_mode = 2

[node name="RuntimePicker" type="FileDialog" parent="Scroll/Content"]
unique_name_in_owner = true
title = "Choose Rookframe development runtime"
file_mode = 0
access = 2
filters = PackedStringArray("rookframe-development-runtime.json ; Rookframe development runtime")

[node name="Restart" type="ConfirmationDialog" parent="Scroll/Content"]
unique_name_in_owner = true
title = "Activate development support"
dialog_text = "Godot reads launch and Game tab settings when the editor opens.\nSave and reopen this editor once to activate them.\nAfter that, Package edits reload in the running World."
ok_button_text = "Save and reopen editor"
